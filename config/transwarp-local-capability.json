{
  "schema": "transwarp/capability-manifest-v1",
  "project": "HC TransWarp Infrastructure",
  "version": "0.4.1",
  "local_first": true,
  "canonical_root": "D:\\HCDecorHUB\\HC TransWarp Infrastructure",
  "data_root": "D:\\HC_DATA\\queue\\transwarp",
  "ingress": {
    "mode": "DIRECT_LOCAL",
    "protocol": "http",
    "host": "127.0.0.1",
    "port": 8787,
    "health": "/health",
    "submit": "/jobs",
    "token_file": "D:\\HC_DATA\\queue\\transwarp\\ingress.secret"
  },
  "runner": {
    "manifest_schema": "transwarp-local/job-v1",
    "inbox": "D:\\HC_DATA\\queue\\transwarp\\inbox",
    "evidence": "D:\\HC_DATA\\queue\\transwarp\\evidence",
    "actions": [
      "process",
      "powershell_file"
    ]
  },
  "routing_policy": [
    "DIRECT_LOCAL_INGRESS",
    "LOCAL_RUNNER_ONESHOT",
    "HCDR_FALLBACK"
  ],
  "remote_policy": {
    "github": "SYNC_ONLY",
    "hcdr": "FALLBACK_ONLY"
  },
  "chat_bootstrap": {
    "rule": "Any chat must resolve this manifest, detect an authorized local bridge, then prefer DIRECT_LOCAL_INGRESS or direct local inbox. Never assume localhost is reachable.",
    "success_marker": "TRANSWARP_LOCAL_CAPABILITY_OK",
    "blocked_marker": "TRANSWARP_LOCAL_CONNECTOR_REQUIRED"
  },
  "bridge": {
    "required_capability": "authorized_local_filesystem_and_terminal",
    "preferred_provider": "Remote Desktop Commander",
    "behavior": {
      "when_available": "Use bridge to health-check P11 ingress or write manifest directly to local inbox, then read local evidence.",
      "when_missing": "Return TRANSWARP_LOCAL_CONNECTOR_REQUIRED. Do not silently use HCDR.",
      "hcdr_use": "Explicit fallback/recovery only."
    }
  }
}