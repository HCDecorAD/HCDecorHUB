{
  "schema_version": "1.1.0",
  "skill_id": "imaster.local-first-execution",
  "name": "iMaster Local-First Execution",
  "owner": "iMaster",
  "scope": "global",
  "autoload": true,
  "activation": {
    "mode": "default",
    "condition": "coding, debugging, build, test, or machine execution is required"
  },
  "route": [
    "CODE",
    "HOCUONG_LOCAL_DIRECT_OR_LOCAL_EXECUTOR",
    "LOCAL_BUILD_OR_RUN",
    "ONE_REAL_TARGETED_TEST",
    "LOCAL_PASS",
    "USE_OR_DONE",
    "GITHUB_SYNC_OR_CI_ONLY_WHEN_NEEDED"
  ],
  "authority_rule": "LOCAL_REAL_TEST_PASS_IS_AUTHORITATIVE",
  "github_role": "SOURCE_VERSION_RELEASE_LEDGER_AND_MINIMAL_VERIFIER_NOT_EXECUTION_FACTORY",
  "github_minimal_verify": [
    "COMMIT_HASH",
    "PASS_MANIFEST",
    "INTEGRITY",
    "SMOKE"
  ],
  "deep_verify": {
    "default": false,
    "allowed_when": [
      "CORE_CHANGE",
      "SECURITY_CHANGE",
      "DATA_MIGRATION",
      "PRODUCTION_CRITICAL_CHANGE",
      "LOCAL_ANOMALY"
    ],
    "rule": "Never replay a passed local gate unless risk requires it."
  },
  "transport_priority": [
    {
      "priority": 1,
      "transport": "LOCAL_DIRECT_OR_LOCAL_EXECUTOR",
      "role": "DEFAULT_MACHINE_CONTROL",
      "when": "healthy local execution route exists"
    },
    {
      "priority": 2,
      "transport": "HCDR",
      "role": "FALLBACK_AND_RECOVERY",
      "when": "direct/local executor cannot reach the required action or transport recovery is needed"
    },
    {
      "priority": 3,
      "transport": "RDC",
      "role": "RESCUE_ONLY",
      "when": "local and HCDR routes cannot complete the required action"
    }
  ],
  "laws": [
    "LOCAL_FIRST",
    "LOCAL_REAL_TEST_PASS_AUTHORITATIVE",
    "DO_NOT_REDO_PASS",
    "MINIMUM_SUFFICIENT_PROOF",
    "TEST_BEFORE_GITHUB",
    "HCDR_IS_FALLBACK_NOT_DEFAULT",
    "RDC_IS_RESCUE_NOT_DEFAULT",
    "PRODUCTION_WRITES_FAIL_CLOSED",
    "NO_OPTIONAL_GATE_BETWEEN_CODE_AND_LOCAL_TEST",
    "LOCAL_PASS_CAN_FINISH_NORMAL_DEV",
    "GITHUB_CI_AFTER_LOCAL_PASS_ONLY_WHEN_NEEDED"
  ],
  "fallback": {
    "on_local_failure": "try safe local recovery -> HCDR fallback when useful -> RDC only if blocker remains -> verify one real targeted result",
    "direct_rdc_normal_path": "FORBIDDEN"
  },
  "evidence_gate": "scripts/imaster-local-first-skill.test.mjs",
  "enforcement": {
    "normal_machine_control_default": "LOCAL_DIRECT_OR_LOCAL_EXECUTOR",
    "hdcr_typo_note": "HCDR is fallback/recovery, not a mandatory first hop",
    "github_replay_after_local_pass": "FORBIDDEN_UNLESS_RISK_OR_ANOMALY_REQUIRES_IT",
    "evidence_fields": [
      "transport_used",
      "fallback_reason_if_any",
      "real_test_result"
    ],
    "inner_loop": "CODE -> LOCAL BUILD/RUN -> ONE REAL TEST -> PASS",
    "external_services": "must not block local-owned development unless required for requested outcome",
    "protection_location": "BOUNDARY_NOT_INNER_LOOP"
  },
  "development_loop": {
    "principle": "BUILD_FAST_INSIDE_PROTECT_AT_BOUNDARY",
    "no_default_dependency_on": [
      "HCDR",
      "GitHub CI",
      "remote approval",
      "full regression suite",
      "release gate"
    ],
    "boundary_only": [
      "auth/credentials",
      "security/sensitive data",
      "destructive/irreversible action",
      "production deploy/release"
    ]
  }
}
