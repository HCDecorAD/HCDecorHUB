{
  "schema": "hc-factory/runtime-evidence-gate-v1",
  "mode": "isolated_candidate",
  "production_mutation": "deny",
  "required": {
    "hocuong_contract_suite": {
      "exit_code": 0
    },
    "reference_capture": {
      "viewports": [
        1440,
        768,
        390
      ],
      "http_200": true,
      "rendered_html": true,
      "screenshot": true
    },
    "rebuild_runtime": {
      "reachable": true,
      "rollback_authority": true
    },
    "visual_diff": {
      "real_pixels": true,
      "fixed_environment": true
    },
    "interaction_qa": true,
    "responsive_qa": true
  },
  "publish": {
    "canonical_url": "https://factory.hcdecorhub.com",
    "allowed_only_after_all_required_pass": true
  }
}
