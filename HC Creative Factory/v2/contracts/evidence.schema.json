{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HC Factory Evidence",
  "type": "object",
  "required": [
    "mission_id",
    "stage",
    "status",
    "artifacts"
  ],
  "properties": {
    "mission_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "status": {
      "enum": [
        "RUNNING",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "uri"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "timestamp": {
      "type": "string"
    }
  }
}